# Copy this file to .env and fill in the values below.
# cp .env.example .env

# â”€â”€ App / Security â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SECRET_KEY=change-this-secret-key-in-production
DEBUG=False

# â”€â”€ Database (PostgreSQL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DATABASE_URL=postgresql+asyncpg://sop_user:sop_password@localhost:5432/hospital_sop

# â”€â”€ Vector store (ChromaDB) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CHROMA_HOST=localhost
CHROMA_PORT=8001

# â”€â”€ LLM provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# One of: groq | anthropic | openai | ollama
LLM_PROVIDER=groq

# Groq â€” free tier, get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Anthropic â€” paid, get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI â€” paid, $5 free credit on signup
OPENAI_API_KEY=

# Ollama â€” free, runs entirely on your own machine, no key needed
OLLAMA_BASE_URL=http://localhost:11434

# â”€â”€ File upload â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
